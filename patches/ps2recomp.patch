+    src/emulator/spu2/SPU2/spu2sys.cpp
+)
+target_sources(ps2_iop PRIVATE ${PS2X_SPU2_SOURCES})
+set_source_files_properties(${PS2X_SPU2_SOURCES} PROPERTIES
+    INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}/src/emulator/spu2;${CMAKE_CURRENT_SOURCE_DIR}/src/emulator/spu2/shim")
+if(MSVC)
+    set_property(SOURCE ${PS2X_SPU2_SOURCES} APPEND PROPERTY COMPILE_OPTIONS
+        "/FI${CMAKE_CURRENT_SOURCE_DIR}/src/emulator/spu2/shim/spu2_prefix.h;/W0")
+else()
+    set_property(SOURCE ${PS2X_SPU2_SOURCES} APPEND PROPERTY COMPILE_OPTIONS
+        "-include;${CMAKE_CURRENT_SOURCE_DIR}/src/emulator/spu2/shim/spu2_prefix.h;-w")
+endif()
+if(EMSCRIPTEN)
+    # Browser: DEV9's sockets go over a WebSocket to the page's relay (no sockets in a browser).
+    target_sources(ps2_iop PRIVATE src/emulator/dev9/web_sockets.cpp)
+endif()
+if(MSVC)
+    set_source_files_properties(${PS2X_DEV9_SOURCES} src/emulator/core/iop_dev9.cpp
+        PROPERTIES COMPILE_OPTIONS "/W0;/wd4996;/utf-8")
+    # PCSX2 is built with UNICODE (GetAddrInfoExW etc.).
+    set_source_files_properties(${PS2X_DEV9_SOURCES} PROPERTIES COMPILE_DEFINITIONS "UNICODE;_UNICODE")
