+	// Each voice has a buffer of decoded samples
+	// ps2recomp: entries 32-34 mirror 0-2, so the 4 interpolation taps are always contiguous
+	// (35 is padding for a 4-wide store)
+	s32 DecodeFifo[32 + 4];
+	u32 DecPosWrite;
+	u32 DecPosRead;
+
+	// it takes a few ticks for voices to start on the real SPU2?
+	void Start();
+	void Stop();
+};
