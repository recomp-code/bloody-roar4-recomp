+            const uint32_t a0 = cpu.gpr[4], a1 = cpu.gpr[5], a2 = cpu.gpr[6], a3 = cpu.gpr[7];
+            auto residentIds = [&](const std::string *name)
+            {
+                std::vector<int> ids;
+                for (const auto &[id, module] : modules)
+                    if (module.resident && (!name || iequals(module.moduleName, *name)))
+                        ids.push_back(id);
+                return ids;
+            };
+            auto writeIds = [&](const std::vector<int> &ids, uint32_t buffer, uint32_t capacity, uint32_t countOut)
+            {
+                uint32_t written = 0;
+                for (int id : ids)
+                {
+                    if (written >= capacity)
+                        break;
+                    if (buffer)
+                        write32(buffer + written * 4u, static_cast<uint32_t>(id));
+                    ++written;
+                }
+                if (countOut)
+                    write32(countOut, static_cast<uint32_t>(ids.size()));
+                return written;
+            };
+            switch (ordinal)
+            {
+            case 16: // GetModuleIdList(int *buf, int size, int *count)
+                cpu.gpr[2] = writeIds(residentIds(nullptr), a0, a1, a2);
+                return true;
+            case 18: // GetModuleIdListByName(name, int *buf, int size, int *count)
+            {
+                const std::string name = memory.readString(a0, 64u);
+                cpu.gpr[2] = writeIds(residentIds(&name), a1, a2, a3);
+                return true;
+            }
+            case 17: // ReferModuleStatus(id, ModuleStatus *)
+            {
+                const auto it = modules.find(static_cast<int>(a0));
+                if (it == modules.end() || a1 == 0u)
+                {
+                    cpu.gpr[2] = kUnknownModule;
+                    return true;
+                }
+                const Module &m = it->second;
+                (void)zeroRam(a1, 96u);
+                const std::string name = m.moduleName.substr(0, 55);
+                (void)writeRam(a1, name.c_str(), name.size() + 1u);
+                write16(a1 + 56u, m.version);
+                write16(a1 + 58u, m.resident ? 3u : 0u); // flags: MSTF_RUNNING
+                write32(a1 + 60u, static_cast<uint32_t>(m.id));
+                write32(a1 + 64u, m.entry);
+                write32(a1 + 68u, m.gp);
+                write32(a1 + 72u, m.base);
+                write32(a1 + 76u, m.size);
+                cpu.gpr[2] = 0u;
+                return true;
+            }
+            case 22: // SearchModuleByName(name)
+            {
+                const std::string name = memory.readString(a0, 64u);
+                const auto ids = residentIds(&name);
+                cpu.gpr[2] = ids.empty() ? kUnknownModule : static_cast<uint32_t>(ids.back());
+                return true;
+            }
+            case 23: // SearchModuleByAddress(addr)
+            {
+                for (const auto &[id, module] : modules)
+                    if (module.resident && a0 >= module.base && a0 < module.base + module.size)
+                    {
+                        cpu.gpr[2] = static_cast<uint32_t>(id);
+                        return true;
+                    }
+                cpu.gpr[2] = kUnknownModule;
+                return true;
+            }
+            default:
+                return false;
+            }
+        }
+
+        // Native EA sound mixer (iop_hle_routines.h). PS2X_IOP_HLE=0 turns it off;
+        // PS2X_IOP_HLE=verify runs the guest code anyway and compares the RAM it leaves behind
+        // with the native result, logging any difference.
+        struct EaMixerVerify
+        {
+            bool active = false;
+            uint32_t ra = 0, sp = 0;
+            std::vector<uint8_t> entry, expected;
+            uint32_t checked = 0, mismatched = 0, foreign = 0;
+        } eaMixerVerify;
+
+        bool runEaMixerHle(CpuState &cpu)
+        {
+            static const int mode = []
+            {
+                const char *env = std::getenv("PS2X_IOP_HLE");
+                if (env && env[0] == '0')
+                    return 0;
+                if (env && std::strcmp(env, "verify") == 0)
+                    return 2;
+                return 1;
+            }();
+            if (mode == 0)
+                return false;
+            uint8_t *ram = memory.ramMutable().data();
+            if (!hle::eaMixerMatches(ram))
+                return false;
+            if (mode == 2)
+            {
+                if (!eaMixerVerify.active)
+                {
+                    eaMixerVerify.entry.assign(ram, ram + IopMemory::RamSize);
+                    eaMixerVerify.expected.assign(ram, ram + IopMemory::RamSize);
+                    const uint32_t saved[5] = {cpu.gpr[16], cpu.gpr[17], cpu.gpr[18], cpu.gpr[19], cpu.gpr[20]};
+                    hle::eaMixerStackFrame(eaMixerVerify.expected.data(), cpu.gpr[29], saved);
+                    hle::eaMixer(eaMixerVerify.expected.data(), cpu.gpr[4], cpu.gpr[5]);
+                    eaMixerVerify.ra = cpu.gpr[31];
+                    eaMixerVerify.sp = cpu.gpr[29];
+                    eaMixerVerify.active = true;
+                }
+                return false; // let the interpreter run the original
+            }
+            static bool s_logged = false;
+            if (!s_logged)
+            {
+                s_logged = true;
+                log(LogLevel::Info, "[IOP] native EA sound mixer active at 0x52D50");
+            }
+            const uint32_t saved[5] = {cpu.gpr[16], cpu.gpr[17], cpu.gpr[18], cpu.gpr[19], cpu.gpr[20]};
+            hle::eaMixerStackFrame(ram, cpu.gpr[29], saved);
+            hle::eaMixer(ram, cpu.gpr[4], cpu.gpr[5]);
+            // Same register effects the caller can observe: return to ra, sp/s-registers unchanged.
+            cpu.pc = cpu.gpr[31];
+            cpu.branchPending = false;
+            totalInstructions += hle::kEaMixerCycles;
+            totalCycles += hle::kEaMixerCycles;
+            return true;
+        }
+
+        // libsd accessors (hle::LibsdRoutine), called from an import stub whose guest target is
+        // known: run natively with the guest's exact effects. Each SPU2 register access happens
+        // at the IOP cycle the interpreter would reach it (the SPU2 catches up to that cycle), and
+        // the call is charged the instructions the guest path takes. PS2X_IOP_HLE=0 runs the
+        // guest code; PS2X_IOP_HLE=verify runs it too and compares the result (v0) with the
+        // native one computed beforehand (setters: the register address; reads at the call cycle).
+        struct LibsdVerify
+        {
+            bool active = false;
+            uint32_t ra = 0;
+            uint32_t sp = 0;
+            uint32_t expected = 0;
+            uint32_t expectedA0 = 0;
+            uint32_t expectedA1 = 0;
+            hle::LibsdRoutine routine = hle::LibsdRoutine::None;
+            uint64_t checked[5] = {};
+            uint64_t mismatched[5] = {}; // registers/addresses (must stay 0)
+            uint64_t readsLater[5] = {}; // getters: the guest read the register later (timing)
+        } libsdVerify;
+        struct LibsdTargets
+        {
+            uint32_t generation = 0;
+            struct Entry
+            {
+                hle::LibsdRoutine routine;
+                uint32_t table; // register table pointer array
+                uint32_t high;  // what the relocated lui loads
+            };
+            std::unordered_map<uint32_t, Entry> routines;
+        } libsdTargets;
+        uint64_t libsdNativeCalls = 0;
+
+        static int libsdHleMode()
+        {
+            static const int mode = []
+            {
+                const char *only = std::getenv("PS2X_IOP_LIBSD"); // PS2X_IOP_LIBSD=1 turns them on (off
+                if (!(only && only[0] == '1'))                    // by default: see iop_imports.cpp)
+                    return 0;
+                const char *env = std::getenv("PS2X_IOP_HLE");
+                if (env && env[0] == '0')
+                    return 0;
+                if (env && std::strcmp(env, "verify") == 0)
+                    return 2;
+                return 1;
+            }();
+            return mode;
+        }
+
+        // Runs routine with a0/a1 from cpu; apply = false computes v0 only (no register writes,
+        // SPU2 reads at the current cycle). Returns the instructions the guest path executes.
+        uint32_t libsdExecute(CpuState &cpu, hle::LibsdRoutine routine, uint32_t table, uint32_t high, bool apply, uint32_t &result,
+                             uint32_t *finalA0 = nullptr, uint32_t *finalA1 = nullptr)
+        {
+            struct Bus
+            {
+                IopMemory &memory;
+                uint64_t &cycles;
+                uint64_t start; // the routine's first instruction runs at this cycle
+                bool apply;
+                uint32_t lw(uint32_t address) { return memory.read32(address); }
+                uint32_t io16(uint32_t address, uint32_t index)
+                {
+                    if (apply)
+                        cycles = start + index;
+                    return memory.read16(address);
+                }
+                void io16(uint32_t address, uint16_t value, uint32_t index)
+                {
+                    if (!apply)
+                        return;
+                    cycles = start + index;
+                    memory.write16(address, value);
+                }
+            } bus{memory, totalCycles, totalCycles, apply};
+            struct
+            {
+                std::array<uint32_t, 32> gpr;
+                uint32_t hi, lo;
+            } regs{cpu.gpr, cpu.hi, cpu.lo};
+            const uint32_t count = hle::libsdRun(routine, regs, bus, table, high, 0u);
+            result = regs.gpr[2];
+            if (finalA0)
+                *finalA0 = regs.gpr[4];
+            if (finalA1)
+                *finalA1 = regs.gpr[5];
+            if (apply)
+            {
+                cpu.gpr = regs.gpr;
+                cpu.hi = regs.hi;
+                cpu.lo = regs.lo;
+                totalCycles = bus.start + count;
+            }
+            return count;
+        }
+
+        bool runLibsdHle(CpuState &cpu, uint32_t target)
+        {
+            const int mode = libsdHleMode();
+            if (mode == 0 || libsdVerify.active)
+                return false;
+            if (libsdTargets.generation != imports.generation())
+            {
+                libsdTargets.routines.clear();
+                libsdTargets.generation = imports.generation();
+            }
+            auto known = libsdTargets.routines.find(target);
+            if (known == libsdTargets.routines.end())
+            {
+                uint32_t table = 0, high = 0;
+                const hle::LibsdRoutine routine = hle::libsdRoutineAt(memory.ram().data(), target, table, high);
+                known = libsdTargets.routines.emplace(target, LibsdTargets::Entry{routine, table, high}).first;
+                if (routine != hle::LibsdRoutine::None)
+                {
+                    char line[96];
+                    std::snprintf(line, sizeof(line), "[IOP] native libsd routine %d at 0x%X (table 0x%X)",
+                                  static_cast<int>(routine), target, table);
+                    log(LogLevel::Info, line);
+                }
+            }
+            const hle::LibsdRoutine routine = known->second.routine;
+            if (routine == hle::LibsdRoutine::None)
+                return false;
+            const uint32_t table = known->second.table;
+            const uint32_t high = known->second.high;
+            if (mode == 2)
+            {
+                // Let the guest run; compare its v0 with the native result at its return
+                uint32_t expected = 0;
+                libsdExecute(cpu, routine, table, high, false, expected, &libsdVerify.expectedA0, &libsdVerify.expectedA1);
+                libsdVerify.active = true;
+                libsdVerify.ra = cpu.gpr[31];
+                libsdVerify.sp = cpu.gpr[29];
+                libsdVerify.expected = expected;
+                libsdVerify.routine = routine;
+                return false;
+            }
+            // The stub (jr ra; li zero, n) counts as one instruction, then the routine's
+            ++totalInstructions;
+            ++totalCycles;
+            uint32_t result = 0;
+            const uint32_t count = libsdExecute(cpu, routine, table, high, true, result);
+            totalInstructions += count;
+            cpu.pc = cpu.gpr[31];
+            cpu.branchPending = false;
+            ++libsdNativeCalls;
+            return true;
+        }
+
+        void finishLibsdVerify(const CpuState &cpu)
+        {
+            libsdVerify.active = false;
+            const int r = static_cast<int>(libsdVerify.routine);
+            ++libsdVerify.checked[r];
+            const bool getter = libsdVerify.routine == hle::LibsdRoutine::GetParam || libsdVerify.routine == hle::LibsdRoutine::GetAddr;
+            // a0/a1 end up holding the register address (or derived values) in every routine
+            const bool registersMatch = cpu.gpr[4] == libsdVerify.expectedA0 && cpu.gpr[5] == libsdVerify.expectedA1;
+            const bool resultMatch = cpu.gpr[2] == libsdVerify.expected;
+            const bool mismatch = !registersMatch || (!getter && !resultMatch);
+            if (mismatch)
+                ++libsdVerify.mismatched[r];
+            else if (!resultMatch)
+                ++libsdVerify.readsLater[r];
+            static uint32_t s_reports = 0;
+            uint64_t total = 0;
+            for (uint64_t value : libsdVerify.checked)
+                total += value;
+            if ((mismatch && s_reports < 40u) || total % 50000u == 1u)
+            {
+                if (mismatch)
+                    ++s_reports;
+                char line[320];
+                std::snprintf(line, sizeof(line),
+                              "[IOP hle verify] libsd %s: a0 %08x/%08x a1 %08x/%08x v0 %08x/%08x (guest/native); checked set/get param %llu/%llu, set/get addr %llu/%llu; "
+                              "mismatched %llu/%llu/%llu/%llu; getter read later %llu/%llu",
+                              mismatch ? "MISMATCH" : "ok", cpu.gpr[4], libsdVerify.expectedA0, cpu.gpr[5], libsdVerify.expectedA1, cpu.gpr[2], libsdVerify.expected,
+                              (unsigned long long)libsdVerify.checked[1], (unsigned long long)libsdVerify.checked[2],
+                              (unsigned long long)libsdVerify.checked[3], (unsigned long long)libsdVerify.checked[4],
+                              (unsigned long long)libsdVerify.mismatched[1], (unsigned long long)libsdVerify.mismatched[2],
+                              (unsigned long long)libsdVerify.mismatched[3], (unsigned long long)libsdVerify.mismatched[4],
+                              (unsigned long long)libsdVerify.readsLater[2], (unsigned long long)libsdVerify.readsLater[4]);
+                log(LogLevel::Info, line);
+            }
+        }
+
+        void finishEaMixerVerify()
+        {
+            eaMixerVerify.active = false;
+            const uint8_t *ram = memory.ram().data();
+            // A difference counts against the mixer only where the native code wrote (expected
+            // differs from the entry snapshot) or where the guest code changed a byte the native
+            // code left alone at a mixer address; other bytes changed meanwhile (interrupt
+            // handlers, DMA during the interpreted call) are reported separately as "foreign".
+            uint32_t diffs = 0, first = 0, foreignBytes = 0;
+            for (uint32_t i = 0; i < IopMemory::RamSize; ++i)
+            {
+                if (ram[i] == eaMixerVerify.expected[i])
+                    continue;
+                if (eaMixerVerify.expected[i] != eaMixerVerify.entry[i])
+                {
+                    if (!diffs)
+                        first = i;
+                    ++diffs;
+                }
+                else
+                {
+                    ++foreignBytes;
+                }
+            }
+            ++eaMixerVerify.checked;
+            if (diffs)
+                ++eaMixerVerify.mismatched;
+            if (foreignBytes)
+                ++eaMixerVerify.foreign;
+            if (diffs || eaMixerVerify.checked % 1000u == 1u)
+            {
+                char line[200];
+                std::snprintf(line, sizeof(line), "[IOP hle verify] call %u: %u mixer bytes differ (first 0x%X), %u foreign; totals %u/%u mismatched, %u with foreign writes",
+                              eaMixerVerify.checked, diffs, first, foreignBytes, eaMixerVerify.mismatched, eaMixerVerify.checked, eaMixerVerify.foreign);
+                log(LogLevel::Info, line);
+            }
+        }
+
+        // Native EA voice loop body (hle::eaVoiceIteration), one voice per call from the loop
+        // head; iterations that call the driver's 0x54F88 stay interpreted. Every SPU2 access
+        // happens at the IOP cycle the interpreter reaches it, and the iteration is charged the
+        // instructions the guest path takes. An interrupt the interpreter would take inside the
+        // iteration (SPU2/DMA completion found by the per-instruction service) is taken after it.
+        // PS2X_IOP_EAVOICES=0 (or PS2X_IOP_HLE=0) runs the guest code; PS2X_IOP_HLE=verify runs
+        // it too, recording its SPU2 accesses, and then replays the native iteration on the entry
+        // state: registers, the memory it reads and writes (the whole RAM every 256 checks) and
+        // the SPU2 accesses with their values and cycles must come out identical.
+        struct EaVoiceTargets
+        {
+            uint32_t generation = 0;
+            bool ready = false;
+            uint32_t target[4] = {}; // the libsd routines its stubs reach
+            hle::EaVoiceLibsd libsd{};
+            uint64_t native = 0, driver = 0;
+        } eaVoice;
+        struct EaVoiceVerify
+        {
+            bool active = false;
+            bool foreign = false; // other code ran inside the interpreted iteration
+            bool full = false;
+            const CpuState *cpu = nullptr;
+            CpuState entry{};
+            uint64_t startCycles = 0, startInstructions = 0;
+            struct Range
+            {
+                uint32_t address, size, offset; // physical, into bytes
+            };
+            std::vector<Range> ranges;
+            std::vector<uint8_t> bytes;
+            std::vector<uint8_t> ram; // full entry RAM (every 256 checks)
+            std::vector<Spu2::Access> trace;
+            uint64_t checked = 0, mismatched = 0, foreignChecks = 0, driver = 0;
+            uint32_t reports = 0;
+        } eaVoiceVerify;
+
+        static int eaVoiceMode()
+        {
+            static const int mode = []
+            {
+                const char *only = std::getenv("PS2X_IOP_EAVOICES");
+                if (only && only[0] == '0')
+                    return 0;
+                const char *env = std::getenv("PS2X_IOP_HLE");
+                if (env && env[0] == '0')
+                    return 0;
+                if (env && std::strcmp(env, "verify") == 0)
+                    return 2;
+                return 1;
+            }();
+            return mode;
+        }
+
+        // The loop and the four libsd routines it reaches through its import stubs, word for word.
+        bool eaVoiceReady()
+        {
+            const uint8_t *ram = memory.ram().data();
+            if (eaVoice.generation != imports.generation())
+            {
+                eaVoice.generation = imports.generation();
+                eaVoice.ready = false;
+                if (!hle::eaVoiceLoopMatches(ram))
+                    return false;
+                bool ok = true;
+                for (int i = 0; i < 4 && ok; ++i)
+                {
+                    const auto call = imports.decode(hle::kEaVoiceStubs[i]);
+                    ok = call && iequals(call->library, "libsd") && call->ordinal == hle::kEaVoiceStubExports[i];
+                    const uint32_t target = ok ? imports.resolve(call->library, call->ordinal, call->version) : 0u;
+                    eaVoice.target[i] = target;
+                    ok = ok && target != 0u &&
+                         hle::libsdRoutineAt(ram, target, eaVoice.libsd.table[i], eaVoice.libsd.high[i]) == hle::kEaVoiceStubRoutines[i];
+                }
+                eaVoice.ready = ok;
+                char line[128];
+                std::snprintf(line, sizeof(line), "[IOP] EA voice loop at 0x%X: %s (libsd table 0x%X)", hle::kEaVoiceLoopAddress,
+                              ok ? (eaVoiceMode() == 2 ? "verifying" : "native") : "libsd not as expected, interpreted", eaVoice.libsd.table[0]);
+                log(LogLevel::Info, line);
+            }
+            return eaVoice.ready;
+        }
+
+        // Guest machine for hle::eaVoiceIteration: the IOP itself (SPU2 accesses at their cycle).
+        struct EaVoiceBus
+        {
+            IopMemory &memory;
+            uint64_t &cycles;
+            uint64_t start;
+            uint32_t lw(uint32_t address) { return memory.read32(address); }
+            uint32_t lhu(uint32_t address) { return memory.read16(address); }
+            uint32_t lbu(uint32_t address) { return memory.read8(address); }
+            void sw(uint32_t address, uint32_t value) { memory.write32(address, value); }
+            void sh(uint32_t address, uint16_t value) { memory.write16(address, value); }
+            void sb(uint32_t address, uint8_t value) { memory.write8(address, value); }
+            uint32_t io16(uint32_t address, uint32_t index)
+            {
+                cycles = start + index;
+                return memory.read16(address);
+            }
+            void io16(uint32_t address, uint16_t value, uint32_t index)
+            {
+                cycles = start + index;
+                memory.write16(address, value);
+            }
+        };
+
+        bool runEaVoiceHle(CpuState &cpu)
+        {
+            const int mode = eaVoiceMode();
+            if (mode == 0 || eaVoiceVerify.active || cpu.branchPending || cpu.pendingLoad)
+                return false;
+            const uint8_t *ram = memory.ram().data();
+            if (!eaVoiceReady())
+                return false;
+            if (cpu.gpr[19] == 0u) // each call of the update: the code is still the same
+            {
+                bool same = hle::eaVoiceLoopMatches(ram);
+                for (int i = 0; i < 4 && same; ++i)
+                {
+                    uint32_t table = 0, high = 0;
+                    same = hle::libsdRoutineAt(ram, eaVoice.target[i], table, high) == hle::kEaVoiceStubRoutines[i] &&
+                           table == eaVoice.libsd.table[i];
+                }
+                if (!same)
+                {
+                    eaVoice.generation = 0; // look again
+                    return false;
+                }
+            }
+            const uint32_t sp = cpu.gpr[29];
+            const uint32_t s1 = memory.read32(sp + 0x20u) + hle::kEaVoiceShadow;
+            const uint32_t slot = memory.read32(sp + 0x1Cu);
+            if (cpu.gpr[19] >= 48u || ((cpu.gpr[16] | sp | s1 | slot) & 3u) != 0u)
+                return false;
+            EaVoiceBus bus{memory, totalCycles, totalCycles};
+            if (hle::eaVoiceCallsDriver(cpu, bus))
+            {
+                ++(mode == 2 ? eaVoiceVerify.driver : eaVoice.driver);
+                return false;
+            }
+            if (mode == 2)
+            {
+                startEaVoiceVerify(cpu, s1, slot);
+                return false; // the interpreter runs it
+            }
+            const uint64_t start = totalCycles;
+            const uint32_t count = hle::eaVoiceIteration(cpu, bus, eaVoice.libsd);
+            totalCycles = start + count;
+            totalInstructions += count;
+            cpu.branchPending = false;
+            if (++eaVoice.native % 500000u == 0u)
+            {
+                char line[128];
+                std::snprintf(line, sizeof(line), "[IOP] EA voice loop: %llu voices native, %llu interpreted (driver call)",
+                              (unsigned long long)eaVoice.native, (unsigned long long)eaVoice.driver);
+                log(LogLevel::Info, line);
+            }
+            return true;
+        }
+
+        void startEaVoiceVerify(const CpuState &cpu, uint32_t s1, uint32_t slot)
+        {
+            EaVoiceVerify &v = eaVoiceVerify;
+            v.active = true;
+            v.foreign = false;
+            v.cpu = &cpu;
+            v.entry = cpu;
+            v.startCycles = totalCycles;
+            v.startInstructions = totalInstructions;
+            v.ranges.clear();
+            v.bytes.clear();
+            // What the iteration reads: its record, shadow, flag bytes, stack slots, libsd's table
+            // (its own words, the slot and NAX state words it writes are compared after)
+            const auto keep = [&](uint32_t address, uint32_t size)
+            {
+                const uint32_t phys = IopMemory::physicalAddress(address);
+                v.ranges.push_back({phys, size, static_cast<uint32_t>(v.bytes.size())});
+                for (uint32_t i = 0; i < size; ++i)
+                    v.bytes.push_back(memory.read8(phys + i));
