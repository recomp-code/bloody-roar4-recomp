+
+#pragma once
+
+#include "common/Pcsx2Defs.h"
+
+namespace PacketReader::IP
+{
+	struct IP_Address
+	{
+		union
+		{
+			u8 bytes[4];
+			u32 integer;
+		};
+
+		bool operator==(const IP_Address& other) const { return this->integer == other.integer; }
+		bool operator!=(const IP_Address& other) const { return this->integer != other.integer; }
