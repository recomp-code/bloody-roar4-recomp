+{
+    struct DEV9Options
+    {
+        enum struct NetApi : int
+        {
+            Unset = 0,
+            PCAP_Bridged = 1,
+            PCAP_Switched = 2,
+            TAP = 3,
+            Sockets = 4,
+        };
+
+        enum struct DnsMode : int
+        {
+            Manual = 0,
+            Auto = 1,
+            Internal = 2,
+        };
