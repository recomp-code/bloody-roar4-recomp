+#elif defined(__APPLE__) || defined(__linux__)
+        // POSIX version of the live ring above: shm_open mapping, events as shared words
+        // (ps2live::eventSet/eventWait), the host started with posix_spawn.
+        struct LiveRing
+        {
+            int mappingFd = -1;
+            pid_t hostPid = 0;
+            int hostStatus = 0;
+            bool hostExited = false;
+            ps2live::RingHeader *header = nullptr;
+            ps2live::RingEvents *events = nullptr;
+            uint8_t *data = nullptr;
+            uint64_t capacity = 0;
