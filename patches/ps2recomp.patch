+            uint32_t readbackBytes() const { return ps2live::ringReadback(header)->bytes; }
+            const uint8_t *readbackPtr() const { return ps2live::readbackData(header); }
+            void waitReadback(uint32_t ms) { WaitForSingleObject(readbackEvent, ms); }
+        };
