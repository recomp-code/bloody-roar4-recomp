+#if defined(_MSC_VER)
+    char *value = nullptr;
+    size_t length = 0;
+    if (_dupenv_s(&value, &length, "PS2X_IOP_RAM_DUMP") == 0 && value)
+    {
+        path = value;
+        std::free(value);
+    }
+#else
+    if (const char *value = std::getenv("PS2X_IOP_RAM_DUMP"))
+    {
+        path = value;
+    }
+#endif
+    if (path.empty())
+    {
+        return;
+    }
+    std::vector<uint8_t> iopRam(2u * 1024u * 1024u);
+    if (!runtime.readIopMemory(0u, iopRam.data(), iopRam.size()))
+    {
+        return;
+    }
+    if (FILE *file = std::fopen(path.c_str(), "wb"))
+    {
+        std::fwrite(iopRam.data(), 1, iopRam.size(), file);
+        std::fclose(file);
+    }
+    // EE RAM next to it (<path>.ee), for locating code the game loads at runtime.
+    if (FILE *file = std::fopen((path + ".ee").c_str(), "wb"))
+    {
+        std::fwrite(const_cast<PS2Runtime &>(runtime).memory().getRDRAM(), 1, PS2_RAM_SIZE, file);
+        std::fclose(file);
