+    src/emulator/dev9/DEV9/Sessions/UDP_Session/UDP_Relay.cpp
+)
+target_sources(ps2_iop PRIVATE ${PS2X_DEV9_SOURCES})
+
+# SPU2 (sound processor): PCSX2's SPU2 (GPL-3.0+), behind core/iop_spu2.cpp. Built with small
+# stand-ins for the PCSX2 headers it includes (src/emulator/spu2/shim, plus the DEV9 shim's types).
+set(PS2X_SPU2_SOURCES
+    src/emulator/spu2/SPU2/ADSR.cpp
