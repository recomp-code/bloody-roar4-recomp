+	// libpad bit order (active high in the ring): 0 SELECT 1 L3 2 R3 3 START 4 UP 5 RIGHT 6 DOWN
+	// 7 LEFT 8 L2 9 R2 10 L1 11 R1 12 TRIANGLE 13 CIRCLE 14 CROSS 15 SQUARE.
+	std::atomic<uint32_t> g_keyButtons{0};
+	std::atomic<uint32_t> g_keyStick{0}; // bit0 left, bit1 right, bit2 up, bit3 down
+
+	uint32_t KeyBit(const char* code, uint32_t* stick)
+	{
+		struct Map { const char* code; uint32_t bit; uint32_t stick; };
+		static const Map kMap[] = {
+			{"ArrowUp", 1u << 4, 0}, {"ArrowRight", 1u << 5, 0}, {"ArrowDown", 1u << 6, 0}, {"ArrowLeft", 1u << 7, 0},
+			{"KeyZ", 1u << 15, 0}, {"KeyX", 1u << 14, 0}, {"KeyC", 1u << 13, 0}, {"KeyV", 1u << 12, 0},
+			{"KeyQ", 1u << 10, 0}, {"KeyE", 1u << 11, 0}, {"Digit1", 1u << 8, 0}, {"Digit3", 1u << 9, 0},
+			{"Enter", 1u << 3, 0}, {"Backspace", 1u << 0, 0}, {"ShiftRight", 1u << 0, 0},
+			{"ControlLeft", 1u << 1, 0}, {"ControlRight", 1u << 1, 0},
+			{"KeyA", 0, 1}, {"KeyD", 0, 2}, {"KeyW", 0, 4}, {"KeyS", 0, 8},
+		};
+		for(const Map& m : kMap)
+		{
+			if(std::strcmp(code, m.code) == 0)
+			{
+				*stick = m.stick;
+				return m.bit;
+			}
+		}
+		*stick = 0;
+		return 0;
+	}
+
+	bool g_debug = false; // <page>?debug: GS statistics every 2 s, F8/F9 dumps
+	int g_scale = 2;      // internal resolution (decided on the page thread, from the URL)
+	bool g_hd = true;     // HD texture pack (data/hd/): on unless <page>?hd=0 (start screen setting)
+	bool g_halfRate = false; // picture at 30 fps (the game at 60): <page>?fps=30
+	bool g_fsr = true;       // FSR 1 upscaling to the window: on unless <page>?fsr=0 (start screen setting)
+	// ?vulocals=1: VU1 context fields kept in wasm locals for whole functions. Off: measured slower in a
+	// match (VU1 worker ~50% vs ~36%: small blocks with many exits flush every written field at each)
+	bool g_vuContextLocals = false;
+	// ?vumodules=1: merge a micro memory image's VU1 blocks into one wasm instance. Off: 2.2x blocks/s in a
+	// bench but no gain in a match (VU1 ~36.5% vs ~36.8%, game thread higher)
+	bool g_vuModuleGroups = false;
+	bool g_vuFlagAnalysis = true; // ?vuflags=0: VU1 flags maintained even when nothing reads them
+	bool g_vuFlagTracking = true; // ?vuflagtrack=0: VU1 flag reads always scan the whole pipeline
+	bool g_vuSuperblocks = true; // ?superblocks=0: one VU1 basic block per compiled function
+	bool g_vuStats = false;  // ?vustats=1: VU1 block transition statistics (use with ?chain=0)
+	int g_vuSlowPercent = 0; // ?vuslow=N: test aid, see RunVu1
+	bool g_vuDump = false;   // ?vudump=1 (with ?chain=0&vustats=1): Module._ps2xVuDump() gives the hottest VU1 blocks' code
+	std::mutex g_vuDumpMutex;
+	std::vector<uint8_t> g_vuDumpBlob;
+	int g_vuChainParam = 1;  // VU1 block chaining: 1 = tail calls if available, else dispatcher; 0 = off (?chain=0); 2 = dispatcher (?chain=dispatch)
+	ps2live::RingHeader* g_ring = nullptr;
