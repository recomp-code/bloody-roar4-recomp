+namespace PacketReader
+{
+	enum struct EtherType : u16
+	{
+		null = 0x0000,
+		IPv4 = 0x0800,
+		ARP = 0x0806,
+		//Tags extend the ether header length
+		VlanQTag = 0x8100,
+		VlanServiceQTag = 0x88A8,
+		VlanDoubleQTag = 0x9100
+	};
+
+	class EthernetFrame
+	{
+	public:
+		MAC_Address destinationMAC{};
+		MAC_Address sourceMAC{};
+
+		u16 protocol = 0;
+		int headerLength = 14;
+		//Length
