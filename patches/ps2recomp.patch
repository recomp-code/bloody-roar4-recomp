+namespace
+{
+    // DMAC addresses (MADR, TADR, a DMAtag's ADDR): bit 31 (SPR) selects the scratchpad, the low
+    // bits are the offset in it. Masking the bit off read the packet from RDRAM's first 16 KB
+    // (Bloody Roar 4 builds texture/VIF packets in the scratchpad). PS2X_DMA_SPR_BIT=0: old behaviour.
+    uint32_t dmacAddress(uint32_t raw)
+    {
+        static const bool s_enabled = []
+        {
+            const char *env = std::getenv("PS2X_DMA_SPR_BIT");
+            return !(env && env[0] == '0');
+        }();
+        if ((raw & 0x80000000u) == 0u)
+            return raw;
+        if (!s_enabled)
+            return raw & 0x7FFFFFFFu;
+        static uint32_t s_logs = 0;
+        if (s_logs < 4u)
+        {
+            ++s_logs;
+            std::fprintf(stderr, "[dma] scratchpad address 0x%08X (SPR bit)\n", raw);
+        }
+        return PS2_SCRATCHPAD_BASE | (raw & (PS2_SCRATCHPAD_SIZE - 1u));
+    }
+}
+
+// PS2X_PATH3_TRACE=<s>: from s seconds after the first DMA, log GIF/VIF1 kicks, PATH3 pieces
+// (masked or sent) and MSKPATH3 changes, up to 20000 lines.
+bool ps2Path3TraceActive()
+{
+    static const double s_start = []
+    {
+        const char *env = std::getenv("PS2X_PATH3_TRACE");
+        return env && env[0] && env[0] != '0' ? std::atof(env) : -1.0;
+    }();
+    if (s_start < 0.0)
+        return false;
+    static const auto s_t0 = std::chrono::steady_clock::now();
+    static uint32_t s_lines = 0;
+    if (std::chrono::duration<double>(std::chrono::steady_clock::now() - s_t0).count() < s_start)
+        return false;
+    return s_lines++ < 20000u;
+}
+
+extern uint64_t g_ps2StatChainTicks; // defined below; frame-budget report
+extern uint64_t g_ps2StatChainTags;
+extern uint64_t g_ps2StatChainCopyTicks;
+extern uint64_t g_ps2StatChainBytes;
+
+namespace ps2_vif1_irq
+{
+    namespace
+    {
+        std::mutex g_mutex;
+        std::deque<uint32_t> g_pending;
+        bool g_inService = false;
+        // Lock-free fast path: takeNext() runs after every special store (drainCompletedDmacHandlers).
+        std::atomic<uint32_t> g_pendingCount{0u};
+        constexpr size_t kMaxPending = 256u;
+    }
+
+    void push(uint32_t vifCode)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_pending.size() < kMaxPending)
+        {
+            g_pending.push_back(vifCode);
+            g_pendingCount.store(static_cast<uint32_t>(g_pending.size()), std::memory_order_release);
+        }
+    }
+
+    bool takeNext(uint32_t &vifCode)
+    {
+        if (g_pendingCount.load(std::memory_order_acquire) == 0u)
+            return false;
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (g_inService || g_pending.empty())
+        {
+            return false;
+        }
