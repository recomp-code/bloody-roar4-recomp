+#define	  SMAP_PHY_STS_RFLT	(1<<6)		/* Remote FauLT */
+#define	  SMAP_PHY_STS_JBDT	(1<<5)		/* JaBber DetecT */
+#define	  SMAP_PHY_STS_ANCP	(1<<4)		/* Auto-Negotiation ComPlete */
+#define	  SMAP_PHY_STS_LPBK	(1<<3)		/* LooPBacK status */
