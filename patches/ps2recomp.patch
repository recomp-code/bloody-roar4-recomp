+
+	public:
+		//Takes ownership of payload
+		EthernetFrame(Payload* data);
+		EthernetFrame(NetPacket* pkt);
+
+		Payload* GetPayload();
+
+		void WritePacket(NetPacket* pkt);
+	};
+} // namespace PacketReader
