+    src/emulator/dev9/DEV9/PacketReader/IP/UDP/DHCP/DHCP_Packet.cpp
+    src/emulator/dev9/DEV9/PacketReader/IP/UDP/DNS/DNS_Classes.cpp
+    src/emulator/dev9/DEV9/PacketReader/IP/UDP/DNS/DNS_Packet.cpp
