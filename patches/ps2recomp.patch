+		PCORE(1, EffectsEndA),
+
+		PCORE(1, Regs.ENDX),
+		PCORE(1, Regs.ENDX) + 1,
+		PCORE(1, Regs.STATX),
+
+		PRAW(0x746),
+		PRAW(0x748), PRAW(0x74A), PRAW(0x74C), PRAW(0x74E),
+		PRAW(0x750), PRAW(0x752), PRAW(0x754), PRAW(0x756),
+		PRAW(0x758), PRAW(0x75A), PRAW(0x75C), PRAW(0x75E),
+
+		//0x760: weird area
+		PCORE(0, MasterVol.Left.Reg_VOL),
+		PCORE(0, MasterVol.Right.Reg_VOL),
