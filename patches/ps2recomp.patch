new file mode 100644
index 000000000..61e8c46aa
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // SPU2, the PS2 sound processor behind the IOP. The emulation is PCSX2's SPU2 (spu2/SPU2: voices,
+    // ADSR, reverb, AutoDMA input, IRQs, DMA timing); this class connects it to the IOP: register
+    // accesses and DMA transfers at the current IOP cycle, and the 48 kHz stereo output pushed to the
+    // host audio queue (see iop_audio.h).
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t kBase = 0x1F900000u;
+        static constexpr uint32_t kEnd = 0x1F910000u; // registers 0x000-0x7FF, the rest as plain memory
+        static constexpr uint64_t kIopCyclesPerSample = 768u; // 36.864 MHz / 48 kHz
+        static constexpr int kIrqLine = 9;
+
+        Spu2();
+        void reset(uint8_t *iopRam = nullptr);
+        // The IOP clock, read at each register access and DMA so the SPU2 catches up first.
+        void setClock(const uint64_t *iopCycle) noexcept { m_clock = iopCycle; }
+
+        // Register accesses as they happen (value and IOP cycle), while a trace is set (the IOP's
+        // HLE verify mode compares a native routine's accesses with the interpreted ones).
+        struct Access
+        {
+            uint32_t phys;
+            uint16_t value;
+            bool write;
+            uint64_t cycle;
+        };
+        void setTrace(std::vector<Access> *trace) noexcept { m_trace = trace; }
+
+        [[nodiscard]] static bool contains(uint32_t phys) noexcept { return phys >= kBase && phys < kEnd; }
+        uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) / 7 (core 1), from or to IOP memory at physical `madr`.
+        void dmaWrite(int core, uint32_t madr, uint32_t bytes);
+        void dmaRead(int core, uint32_t madr, uint32_t bytes);
+        // MADR as the SPU2 advances it through the transfer.
+        [[nodiscard]] uint32_t dmaMadr(int core) const;
+        void setDmaMadr(int core, uint32_t madr);
+
+        // Mixes every 48 kHz sample up to the given IOP cycle.
+        void advanceTo(uint64_t iopCycle);
+        // True once for each raised SPU2 interrupt (IOP interrupt line 9).
+        bool takeIrq();
+        // True once when the DMA of the given core has finished.
+        bool takeDmaDone(int core);
+
+    private:
+        [[nodiscard]] uint32_t now() const noexcept { return m_clock ? static_cast<uint32_t>(*m_clock) : 0u; }
+
+        const uint64_t *m_clock = nullptr;
+        std::vector<Access> *m_trace = nullptr;
+        uint64_t m_statSamples = 0u;
+        uint32_t m_statIrqs = 0u;
+        uint32_t m_statDmaBytes = 0u;
+        int32_t m_statPeak = 0;
+    };
+}
