+static __forceinline s32 clamp_mix(s32 x)
+{
+	return std::clamp(x, -0x8000, 0x7fff);
+}
+
+static __forceinline StereoOut32 clamp_mix(StereoOut32 sample)
+{
+	return StereoOut32(clamp_mix(sample.Left), clamp_mix(sample.Right));
+}
