+    constexpr uint32_t kEaVoiceShadow = 0x0005DDB8u; // + 0x20(sp): the SPU2-side copy of each voice
+    constexpr uint32_t kEaVoiceState = 0x0005E038u;  // + 0x20(sp) + 0x3C: last record word written
+    // Every word of the loop as relocated at 0x4CF00 (jal/j targets included).
