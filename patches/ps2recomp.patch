+            static void fence() { __atomic_thread_fence(__ATOMIC_SEQ_CST); }
+            void wakeData() { ps2live::eventSet(&events->data); }
+            uint32_t readbackSeq() const { return __atomic_load_n(&events->readbackSeq, __ATOMIC_ACQUIRE); }
+            uint32_t readbackBytes() const { return events->readbackBytes; }
+            const uint8_t *readbackPtr() const { return ps2live::readbackData(header); }
