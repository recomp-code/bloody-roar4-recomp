     return static_cast<uint8_t>((valueHi >> ((byteIndex - 8u) * 8u)) & 0xFFu);
 }
 
+// Guest write watchpoints (PS2X_WATCH_ADDR=addr[,addr...], up to 4): every recompiled store
+// that touches a watched address is reported with the guest pc/ra (see ps2_runtime.cpp).
+extern uint32_t g_ps2WriteWatch[4];
+extern uint32_t g_ps2WriteWatchCount;
+void ps2ReportWatchedWrite(uint32_t guestAddr, uint32_t size, uint64_t valueLo, const char *op, const R5900Context *ctx);
+
 inline void ps2TraceGuestWrite(uint8_t *rdram,
                                uint32_t guestAddr,
                                uint32_t size,
@@ -246,13 +252,23 @@ inline void ps2TraceGuestWrite(uint8_t *rdram,
                                const R5900Context *ctx)
 {
     (void)rdram;
-    (void)guestAddr;
-    (void)size;
-    (void)valueLo;
     (void)valueHi;
-    (void)op;
-    (void)ctx;
-    // TODO we dont need this anymore so on next release it will be deleted
+#if defined(__EMSCRIPTEN__)
+    // Browser build: no write watches (a debugging aid), so no check on every guest store
+    (void)guestAddr; (void)size; (void)valueLo; (void)op; (void)ctx;
+    return;
+#endif
+    if (g_ps2WriteWatchCount == 0u)
+        return;
+    const uint32_t address = guestAddr & PS2_RAM_MASK;
+    for (uint32_t i = 0; i < g_ps2WriteWatchCount; ++i)
+    {
+        if (g_ps2WriteWatch[i] - address < size)
+        {
+            ps2ReportWatchedWrite(address, size, valueLo, op, ctx);
+            return;
+        }
+    }
