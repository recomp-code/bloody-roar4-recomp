+                r[v1] = r[one] << k;
+                r[v0] = 0u;
+                n += 3u;
+                return;
+            }
+            r[v1] = r[zero] << k;
+            n += 2u;
+            if (r[shift] != 0u)
+            {
+                r[shift] = 0u - r[s3];
+                r[shift] = r[one] >> (r[shift] & 31u);
+                r[v1] |= r[shift];
+                n += 3u;
+            }
+            r[v0] = r[one] << k;
+            n += 1u;
+        };
