+    static int s_countdown = []
+    {
+        const char *at = std::getenv("PS2X_IOP_RAM_DUMP_AT");
+        const int value = at ? std::atoi(at) : 0;
+        return value > 0 ? value : 45;
+    }();
+    if (s_countdown <= 0 || --s_countdown != 0)
+    {
+        return;
+    }
