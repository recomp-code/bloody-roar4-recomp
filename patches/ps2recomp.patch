diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 000000000..efb5ed38f
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,157 @@
+#include "iop_spu2.h"
+
+#include "ps2x/iop/iop_audio.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        // Host-facing queue of mixed audio (about one second; the oldest frames are dropped when
+        // nobody is consuming them).
+        constexpr size_t kQueueFrames = 48000u;
+        std::mutex g_audioMutex;
+        std::vector<int16_t> g_audioQueue(kQueueFrames * 2u);
+        size_t g_audioRead = 0u;  // in frames
+        size_t g_audioCount = 0u; // in frames
+
+        void pushAudioFrames(const int16_t *samples, size_t frames)
+        {
+            std::lock_guard<std::mutex> lock(g_audioMutex);
+            for (size_t i = 0; i < frames; ++i)
+            {
+                if (g_audioCount == kQueueFrames)
+                {
+                    g_audioRead = (g_audioRead + 1u) % kQueueFrames;
+                    --g_audioCount;
+                }
+                const size_t slot = (g_audioRead + g_audioCount) % kQueueFrames;
+                g_audioQueue[slot * 2u] = samples[i * 2u];
+                g_audioQueue[slot * 2u + 1u] = samples[i * 2u + 1u];
+                ++g_audioCount;
+            }
+        }
+    }
+
+    size_t readAudioFrames(int16_t *dst, size_t frames)
+    {
+        std::lock_guard<std::mutex> lock(g_audioMutex);
+        const size_t count = std::min(frames, g_audioCount);
+        for (size_t i = 0; i < count; ++i)
+        {
+            const size_t slot = (g_audioRead + i) % kQueueFrames;
+            dst[i * 2u] = g_audioQueue[slot * 2u];
+            dst[i * 2u + 1u] = g_audioQueue[slot * 2u + 1u];
+        }
+        g_audioRead = (g_audioRead + count) % kQueueFrames;
+        g_audioCount -= count;
+        return count;
+    }
+
+    size_t queuedAudioFrames()
+    {
+        std::lock_guard<std::mutex> lock(g_audioMutex);
+        return g_audioCount;
+    }
+}
+
+#include "../spu2/spu2_bridge.h"
+
+namespace ps2x::iop::detail
+{
+    Spu2::Spu2()
+    {
+        reset();
+    }
+
+    void Spu2::reset(uint8_t *iopRam)
+    {
+        ps2x::spu2::reset(iopRam);
+        m_statSamples = 0u;
+        m_statIrqs = 0u;
+        m_statDmaBytes = 0u;
+        m_statPeak = 0;
+    }
+
+    uint16_t Spu2::read16(uint32_t phys)
+    {
+        const uint16_t value = ps2x::spu2::read(now(), phys);
+        if (m_trace)
+            m_trace->push_back({phys, value, false, m_clock ? *m_clock : 0u});
+        return value;
+    }
+
+    void Spu2::write16(uint32_t phys, uint16_t value)
+    {
+        if (m_trace)
+            m_trace->push_back({phys, value, true, m_clock ? *m_clock : 0u});
+        ps2x::spu2::write(now(), phys, value);
+    }
+
+    void Spu2::dmaWrite(int core, uint32_t madr, uint32_t bytes)
+    {
+        m_statDmaBytes += bytes;
+        ps2x::spu2::dmaWrite(now(), core, madr, bytes / 2u);
+    }
+
+    void Spu2::dmaRead(int core, uint32_t madr, uint32_t bytes)
+    {
+        ps2x::spu2::dmaRead(now(), core, madr, bytes / 2u);
+    }
+
+    uint32_t Spu2::dmaMadr(int core) const
+    {
+        return ps2x::spu2::dmaMadr(core);
+    }
+
+    void Spu2::setDmaMadr(int core, uint32_t madr)
+    {
+        ps2x::spu2::setDmaMadr(core, madr);
+    }
+
+    bool Spu2::takeIrq()
+    {
+        const bool irq = ps2x::spu2::takeIrq();
+        m_statIrqs += irq ? 1u : 0u;
+        return irq;
+    }
+
+    bool Spu2::takeDmaDone(int core)
+    {
+        return ps2x::spu2::takeDmaDone(core);
+    }
+
+    void Spu2::advanceTo(uint64_t iopCycle)
+    {
+        ps2x::spu2::advance(static_cast<uint32_t>(iopCycle));
+        // The SPU2 advances about one sample at a time (each register access and every 768 IOP
+        // cycles); hand the host queue blocks of 64 frames (1.3 ms) instead of locking it per sample.
+        std::vector<int16_t> &out = ps2x::spu2::output();
+        if (out.size() < 64u * 2u)
+            return;
+        const size_t frames = out.size() / 2u;
+        ps2x::iop::pushAudioFrames(out.data(), frames);
+        m_statSamples += frames;
+        for (const int16_t sample : out)
+            m_statPeak = std::max<int32_t>(m_statPeak, std::abs(static_cast<int32_t>(sample)));
+        out.clear();
+        if (m_statSamples >= 48000u * 5u)
+        {
+            std::fprintf(stderr, "[spu2] pcsx2 core: samples=%llu dmaBytes=%u irqs=%u peak=%d%s\n",
+                         static_cast<unsigned long long>(m_statSamples), m_statDmaBytes, m_statIrqs, m_statPeak,
+                         ps2x::spu2::describe().c_str());
+            m_statSamples = 0u;
+            m_statDmaBytes = 0u;
+            m_statIrqs = 0u;
+            m_statPeak = 0;
+        }
+    }
+}
